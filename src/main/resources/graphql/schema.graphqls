type User {
    id: ID!
    name: String!
    email: String!
    role: String!
    status: String!
}

input UpdateUserRequest {
    name: String
    email: String
}

type Query {
    userById(id: ID!): User
    allUsers: [User!]!
}

type Mutation {
    createUser(name: String!, email: String!): User!
    updateUser(id: ID!, input: UpdateUserRequest!): User!
    deactivateUser(id: ID!): User!
}